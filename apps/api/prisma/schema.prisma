generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUSINESS
  BRAND
  SUPER_ADMIN
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
  MIXTO
}

enum LayawayStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum SplitPaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum ProductRequestType {
  CREATE_PRODUCT
  RESTOCK
  WITHDRAWAL
}

enum ProductRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ScheduleType {
  STOCK_DELIVERY
  CUT_PICKUP
}

enum OnboardingStep {
  REGISTERED
  EMAIL_VERIFIED
  PLAN_SELECTED
  BUSINESS_CREATED
  DONE
}

enum PlanType {
  NEGOCIO
  CLINICA
  RESTAURANTE
  MARCA
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
}

enum CommissionFeePayer {
  BRAND
  CLIENT
  BUSINESS
}

enum CutoffType {
  WEEKLY
  MONTHLY_FIXED
}

enum UsdRateMode {
  FIXED
  AUTOMATIC
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ConversationRole {
  USER
  ASSISTANT
}

model Tenant {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  active             Boolean              @default(true)
  rfc                String?
  socialUrl          String?
  address            String?
  logoUrl            String?
  onboardingComplete Boolean              @default(true)
  users              User[]
  employees          Employee[]
  brands             Brand[]
  sales              Sale[]
  customers          Customer[]
  giftCards          GiftCard[]
  layaways           Layaway[]
  productRequests    ProductRequest[]
  agendaSettings     AgendaSettings?
  weeklyRules        WeeklyScheduleRule[]
  scheduleSlots      ScheduleSlot[]
  stockAppointments  StockAppointment[]
  appointments       Appointment[]
  sucursales         Sucursal[]
  conversations      Conversation[]
  whatsappConfig     WhatsappConfig?
  services           Service[]
  businessHours      BusinessHour[]
  categories         Category[]
  subscription       TenantSubscription?
  preferences        BusinessPreferences?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  password           String
  name               String
  role               Role
  mustChangePassword Boolean                 @default(false)
  phone              String?
  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  timezone           String?                 @default("America/Mexico_City")
  onboardingStep     OnboardingStep          @default(DONE)
  tenantId           String?
  tenant             Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId            String?
  brand              Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  stockEntries       StockEntry[]
  sales              Sale[]                  @relation("SaleCreatedBy")
  attendedSales      Sale[]                  @relation("SaleAttendedByUser")
  layaways           Layaway[]
  requestedProducts  ProductRequest[]        @relation("ProductRequestCreatedBy")
  acceptedProducts   ProductRequest[]        @relation("ProductRequestAcceptedBy")
  rejectedProducts   ProductRequest[]        @relation("ProductRequestRejectedBy")
  stockAppointments  StockAppointment[]
  ownedBrands        Brand[]                 @relation("BrandOwner")
  termsAcceptances   TermsAcceptance[]
  emailCodes         EmailVerificationCode[]
  smsCodes           SmsVerificationCode[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([tenantId])
}

model Employee {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  active        Boolean  @default(true)
  // Futuro: userId String? @unique para vincular login/permisos
  attendedSales Sale[]   @relation("SaleAttendedByEmployee")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, active])
}

model Brand {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  contactEmail        String?
  whatsapp            String?
  active              Boolean            @default(true)
  isHouseBrand        Boolean            @default(false)
  monthlyRent         Decimal            @default(0) @db.Decimal(12, 2)
  assignedSpace       String?
  phone               String?
  /** Días del mes para corte (1–31). Si Preferencias tiene corte mensual, se alinean. */
  cutoffDaySlots      Int[]              @default([])
  commissionPercent   Decimal            @default(0) @db.Decimal(5, 2)
  cardFeePayer        CommissionFeePayer @default(BRAND)
  transferFeePayer    CommissionFeePayer @default(BRAND)
  inviteCodeHash      String?
  inviteCodeExpiresAt DateTime?
  ownerUserId         String?
  owner               User?              @relation("BrandOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  products            Product[]
  users               User[]
  productRequests     ProductRequest[]
  stockAppointments   StockAppointment[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([ownerUserId])
}

model Product {
  id              String           @id @default(cuid())
  brandId         String
  brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name            String
  sku             String
  description     String?
  price           Decimal?         @db.Decimal(10, 2)
  imageUrl        String?
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stock           Stock?
  stockEntries    StockEntry[]
  saleLines       SaleLine[]
  layawayLines    LayawayLine[]
  productRequests ProductRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([brandId, sku])
  @@index([categoryId])
}

model Stock {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  minStock  Int      @default(5)
  updatedAt DateTime @updatedAt
}

model StockEntry {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

model Customer {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  sales     Sale[]
  layaways  Layaway[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model GiftCard {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  balance   Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Sale {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNumber   Int           @unique @default(autoincrement())
  paymentMethod  PaymentMethod
  soldAt         DateTime      @default(now())
  ticketComment  String?
  applyTax       Boolean       @default(false)
  taxRate        Decimal       @default(0.16) @db.Decimal(5, 4)
  taxAmount      Decimal       @default(0) @db.Decimal(10, 2)
  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  giftCardAmount Decimal       @default(0) @db.Decimal(10, 2)
  createdById       String?
  createdBy         User?         @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attendedById      String?
  attendedBy        Employee?     @relation("SaleAttendedByEmployee", fields: [attendedById], references: [id], onDelete: SetNull)
  attendedByUserId  String?
  attendedByUser    User?         @relation("SaleAttendedByUser", fields: [attendedByUserId], references: [id], onDelete: SetNull)
  customerId        String?
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lines          SaleLine[]
  payments       SalePayment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId, soldAt])
}

model SaleLine {
  id           String  @id @default(cuid())
  saleId       String
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  commission   Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  inSettlement Boolean @default(false)
  paid         Boolean @default(false)

  @@index([productId])
  @@index([saleId])
}

model SalePayment {
  id     String             @id @default(cuid())
  saleId String
  sale   Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method SplitPaymentMethod
  amount Decimal            @db.Decimal(10, 2)

  @@index([saleId])
}

model Layaway {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  status        LayawayStatus    @default(OPEN)
  subtotal      Decimal          @db.Decimal(10, 2)
  total         Decimal          @db.Decimal(10, 2)
  balance       Decimal          @db.Decimal(10, 2)
  deposit       Decimal          @default(0) @db.Decimal(10, 2)
  ticketComment String?
  applyTax      Boolean          @default(false)
  taxRate       Decimal          @default(0.16) @db.Decimal(5, 4)
  taxAmount     Decimal          @default(0) @db.Decimal(10, 2)
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         LayawayLine[]
  payments      LayawayPayment[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model LayawayLine {
  id        String  @id @default(cuid())
  layawayId String
  layaway   Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  @@index([layawayId])
  @@index([productId])
}

model LayawayPayment {
  id        String             @id @default(cuid())
  layawayId String
  layaway   Layaway            @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  method    SplitPaymentMethod
  amount    Decimal            @db.Decimal(10, 2)
  createdAt DateTime           @default(now())

  @@index([layawayId])
}

model ProductRequest {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId       String
  brand         Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                 @relation("ProductRequestCreatedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  type          ProductRequestType
  status        ProductRequestStatus @default(PENDING)
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String?
  sku           String?
  categoryId    String?
  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description   String?
  price         Decimal?             @db.Decimal(10, 2)
  imageUrl      String?
  quantity      Int
  minStock      Int                  @default(5)
  notes         String?
  acceptedById  String?
  acceptedBy    User?                @relation("ProductRequestAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  rejectedById  String?
  rejectedBy    User?                @relation("ProductRequestRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([brandId, status])
}

model AgendaSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockDeliveryEnabled Boolean  @default(true)
  cutPickupEnabled     Boolean  @default(true)
  timezone             String   @default("America/Mexico_City")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// One weekly recurrence row per action + weekday (1=Mon … 7=Sun).
model WeeklyScheduleRule {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            ScheduleType
  weekday         Int
  startTime       String
  endTime         String
  intervalMinutes Int
  active          Boolean        @default(true)
  slots           ScheduleSlot[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, type, weekday])
  @@index([tenantId, type])
}

model ScheduleSlot {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        ScheduleType
  startAt     DateTime
  endAt       DateTime
  active      Boolean             @default(true)
  ruleId      String?
  rule        WeeklyScheduleRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  appointment StockAppointment?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, type, startAt, endAt])
  @@index([tenantId, type, startAt])
  @@index([ruleId])
}

/// Agenda de entregas/retiros (antes Appointment). Conserva brandId/slotId/bookedById.
model StockAppointment {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId    String
  brand      Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slotId     String       @unique
  slot       ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  bookedById String
  bookedBy   User         @relation(fields: [bookedById], references: [id], onDelete: Restrict)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([tenantId, createdAt])
  @@index([brandId, createdAt])
}

model WhatsappConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumberId      String   @default("")
  wabaId             String   @default("")
  accessToken        String   @default("")
  webhookVerifyToken String   @default("")
  systemPrompt       String   @default("") @db.Text
  isActive           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([phoneNumberId])
}

model Service {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  durationMinutes  Int
  price            Decimal       @db.Decimal(10, 2)
  isActive         Boolean       @default(true)
  appointments     Appointment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([tenantId])
}

model BusinessHour {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model Sucursal {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  isActive      Boolean        @default(true)
  appointments  Appointment[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Conversation {
  id                 String                 @id @default(cuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerPhone      String
  customerName       String?
  aiEnabled          Boolean                @default(true)
  selectedSucursalId String?
  selectedSucursal   Sucursal?              @relation(fields: [selectedSucursalId], references: [id], onDelete: SetNull)
  humanRequestedAt   DateTime?
  humanRequestReason String?
  messages           ConversationMessage[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([tenantId, customerPhone])
  @@index([tenantId])
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ConversationRole
  content        String           @db.Text
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

/// Citas a clientes (WhatsApp / clínica). Tabla nueva, sin brandId/slotId/bookedById.
model Appointment {
  id            String            @id @default(cuid())
  tenantId      String
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId    String?
  sucursal      Sucursal?         @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  serviceId     String?
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String
  startTime     DateTime
  endTime       DateTime
  status        AppointmentStatus @default(PENDING)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@index([sucursalId])
}

model TermsDocument {
  id          String   @id @default(cuid())
  version     String   @unique
  title       String
  content     String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  signedName String
  acceptedAt DateTime @default(now())
  ip         String?

  @@unique([userId, version])
  @@index([userId])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SmsVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PromoCode {
  id             String   @id @default(cuid())
  code           String   @unique
  extraTrialDays Int      @default(15)
  active         Boolean  @default(true)
  maxUses        Int?
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
}

model TenantSubscription {
  id                  String             @id @default(cuid())
  tenantId            String             @unique
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planType            PlanType
  status              SubscriptionStatus @default(TRIALING)
  trialEndsAt         DateTime
  promoCodeUsed       String?
  /// Stub de pago futuro (Stripe / Mercado Pago). true = eligió prueba sin cobrar aún.
  paymentDeferred     Boolean            @default(false)
  currentPeriodEndsAt DateTime?
  /// "stripe" | "mercadopago" | null hasta integrar cobro.
  paymentProvider     String?
  externalCustomerId  String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model BusinessPreferences {
  id                          String       @id @default(cuid())
  tenantId                    String       @unique
  tenant                      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryTerminalCommission   Decimal?     @db.Decimal(5, 2)
  secondaryTerminalCommission Decimal?     @db.Decimal(5, 2)
  transferCommission          Decimal?     @db.Decimal(5, 2)
  layawayDueDays              Int          @default(15)
  labelWidthMm                Int?
  labelHeightMm               Int?
  flexibleInventory           Boolean      @default(false)
  printTickets                Boolean      @default(true)
  ticketFixedComment          String?
  chargeIva                   Boolean      @default(false)
  usdEnabled                  Boolean      @default(false)
  usdRateMode                 UsdRateMode?
  usdFixedRate                Decimal?     @db.Decimal(10, 4)
  cutoffType                  CutoffType   @default(MONTHLY_FIXED)
  cutoffWeekday               Int?
  cutoffDaySlots              Int[]
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
}

model Category {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  active          Boolean          @default(true)
  products        Product[]
  productRequests ProductRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}
