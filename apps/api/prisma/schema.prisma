generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUSINESS
  BRAND
  SUPER_ADMIN
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
  MIXTO
}

enum LayawayStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum SplitPaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

enum ProductRequestType {
  CREATE_PRODUCT
  RESTOCK
  WITHDRAWAL
}

enum ProductRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ScheduleType {
  STOCK_DELIVERY
  CUT_PICKUP
}

enum OnboardingStep {
  REGISTERED
  EMAIL_VERIFIED
  PLAN_SELECTED
  BUSINESS_CREATED
  DONE
}

enum PlanType {
  NEGOCIO
  CLINICA
  RESTAURANTE
  MARCA
  CITAS_RECORDATORIOS
  CITAS_PANEL
  CITAS_IA
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
}

enum CommissionFeePayer {
  BRAND
  CLIENT
  BUSINESS
}

enum CutoffType {
  WEEKLY
  MONTHLY_FIXED
}

enum RentPaymentStatus {
  PENDING
  PAID
}

enum CutoffSettlementStatus {
  OPEN
  CLOSED
  PAID
}

enum UsdRateMode {
  FIXED
  AUTOMATIC
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  /// El cliente no llegó (permite medir la tasa de inasistencia).
  NO_SHOW
}

enum ConversationRole {
  USER
  ASSISTANT
}

model Tenant {
  id                    String                  @id @default(cuid())
  name                  String
  slug                  String                  @unique
  active                Boolean                 @default(true)
  rfc                   String?
  socialUrl             String?
  address               String?
  logoUrl               String?
  onboardingComplete    Boolean                 @default(true)
  users                 User[]
  employees             Employee[]
  brands                Brand[]
  sales                 Sale[]
  customers             Customer[]
  giftCards             GiftCard[]
  layaways              Layaway[]
  productRequests       ProductRequest[]
  agendaSettings        AgendaSettings?
  weeklyRules           WeeklyScheduleRule[]
  scheduleSlots         ScheduleSlot[]
  stockAppointments     StockAppointment[]
  appointments          Appointment[]
  sucursales            Sucursal[]
  conversations         Conversation[]
  whatsappConfig        WhatsappConfig?
  services              Service[]
  businessHours         BusinessHour[]
  categories            Category[]
  subscription          TenantSubscription?
  preferences           BusinessPreferences?
  saleCounter           TenantSaleCounter?
  rentPayments          BrandRentPayment[]
  cutoffSettlements     BrandCutoffSettlement[]
  cancelledSales        CancelledSale[]
  cashSessions          CashSession[]
  /// Retención: fecha en que se avisó por correo que la cuenta inactiva será eliminada.
  retentionNoticeSentAt DateTime?
  /// Suspensión desde el panel de plataforma (`active = false`): cuándo y por qué.
  suspendedAt           DateTime?
  suspendedReason       String?
  /// Código para recomendar COSDI (ej. ESTETICA-ANA). Se genera al consultarlo por primera vez.
  referralCode          String?                 @unique
  referralsMade         Referral[]              @relation("ReferralReferrer")
  referredBy            Referral?               @relation("ReferralReferred")
  /// Cuenta de prueba interna: aparece en el panel, pero no recibe correos masivos ni automáticos
  /// (avisos de términos, renovación o eliminación por inactividad) y nunca se elimina por inactividad.
  isTest                Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

model User {
  id                 String                  @id @default(cuid())
  email              String                  @unique
  password           String
  name               String
  role               Role
  mustChangePassword Boolean                 @default(false)
  phone              String?
  phoneVerifiedAt    DateTime?
  emailVerifiedAt    DateTime?
  timezone           String?                 @default("America/Mexico_City")
  onboardingStep     OnboardingStep          @default(DONE)
  tenantId           String?
  tenant             Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId            String?
  brand              Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  stockEntries       StockEntry[]
  sales              Sale[]                  @relation("SaleCreatedBy")
  attendedSales      Sale[]                  @relation("SaleAttendedByUser")
  layaways           Layaway[]
  requestedProducts  ProductRequest[]        @relation("ProductRequestCreatedBy")
  acceptedProducts   ProductRequest[]        @relation("ProductRequestAcceptedBy")
  rejectedProducts   ProductRequest[]        @relation("ProductRequestRejectedBy")
  stockAppointments  StockAppointment[]
  ownedBrands        Brand[]                 @relation("BrandOwner")
  termsAcceptances   TermsAcceptance[]
  emailCodes         EmailVerificationCode[]
  smsCodes           SmsVerificationCode[]
  consentEvents      ConsentEvent[]
  /// 2FA (TOTP): secreto cifrado con AES-256-GCM (ver lib/totp.ts). Sin `totpEnabledAt` está pendiente de confirmar.
  totpSecret         String?
  totpEnabledAt      DateTime?
  /// Último paso TOTP aceptado: impide reutilizar el mismo código.
  totpLastStep       Int?
  /// Códigos de recuperación de un solo uso (hash SHA-256).
  totpRecoveryCodes  String[]                @default([])
  /// Consentimiento de correos de marketing (aparte de los términos; apagado por defecto).
  marketingOptIn     Boolean                 @default(false)
  marketingOptInAt   DateTime?
  marketingOptOutAt  DateTime?
  /// Cuenta eliminada a petición del titular (datos anonimizados; no puede iniciar sesión).
  deletedAt          DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([tenantId])
}

model Employee {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  active        Boolean  @default(true)
  // Futuro: userId String? @unique para vincular login/permisos
  attendedSales Sale[]   @relation("SaleAttendedByEmployee")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, active])
}

model Brand {
  id                  String                  @id @default(cuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  contactEmail        String?
  whatsapp            String?
  active              Boolean                 @default(true)
  isHouseBrand        Boolean                 @default(false)
  monthlyRent         Decimal                 @default(0) @db.Decimal(12, 2)
  assignedSpace       String?
  phone               String?
  /**
   * Días del mes para corte (1–31). Si Preferencias tiene corte mensual, se alinean.
   */
  cutoffDaySlots      Int[]                   @default([])
  commissionPercent   Decimal                 @default(0) @db.Decimal(5, 2)
  cardFeePayer        CommissionFeePayer      @default(BRAND)
  transferFeePayer    CommissionFeePayer      @default(BRAND)
  inviteCodeHash      String?
  inviteCodeExpiresAt DateTime?
  ownerUserId         String?
  owner               User?                   @relation("BrandOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  products            Product[]
  users               User[]
  productRequests     ProductRequest[]
  stockAppointments   StockAppointment[]
  rentPayments        BrandRentPayment[]
  cutoffSettlements   BrandCutoffSettlement[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([ownerUserId])
}

model Product {
  id              String           @id @default(cuid())
  brandId         String
  brand           Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name            String
  sku             String
  description     String?
  price           Decimal?         @db.Decimal(10, 2)
  imageUrl        String?
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stock           Stock?
  stockEntries    StockEntry[]
  saleLines       SaleLine[]
  layawayLines    LayawayLine[]
  productRequests ProductRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([brandId, sku])
  @@index([categoryId])
}

model Stock {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  minStock  Int      @default(5)
  updatedAt DateTime @updatedAt
}

model StockEntry {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

model Customer {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  sales     Sale[]
  layaways  Layaway[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, name])
  @@index([tenantId, phone])
}

model GiftCard {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  balance   Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model TenantSaleCounter {
  tenantId         String @id
  tenant           Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nextTicketNumber Int    @default(1)
}

model Sale {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNumber     Int
  paymentMethod    PaymentMethod
  soldAt           DateTime      @default(now())
  ticketComment    String?
  applyTax         Boolean       @default(false)
  taxRate          Decimal       @default(0.16) @db.Decimal(5, 4)
  taxAmount        Decimal       @default(0) @db.Decimal(10, 2)
  subtotal         Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @default(0) @db.Decimal(10, 2)
  giftCardAmount   Decimal       @default(0) @db.Decimal(10, 2)
  createdById      String?
  createdBy        User?         @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attendedById     String?
  attendedBy       Employee?     @relation("SaleAttendedByEmployee", fields: [attendedById], references: [id], onDelete: SetNull)
  attendedByUserId String?
  attendedByUser   User?         @relation("SaleAttendedByUser", fields: [attendedByUserId], references: [id], onDelete: SetNull)
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Venta generada al liquidar un apartado (sus pagos ya se contaron como abonos).
  layawayId        String?       @unique
  layaway          Layaway?      @relation(fields: [layawayId], references: [id], onDelete: SetNull)
  lines            SaleLine[]
  payments         SalePayment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([tenantId, ticketNumber])
  @@index([tenantId, soldAt])
}

model BrandRentPayment {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  amount    Decimal           @db.Decimal(12, 2)
  status    RentPaymentStatus @default(PENDING)
  dueDate   DateTime
  paidAt    DateTime?
  paidById  String?
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([brandId, year, month])
  @@index([tenantId, status, dueDate])
}

model BrandCutoffSettlement {
  id          String                 @id @default(cuid())
  tenantId    String
  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  periodFrom  DateTime
  periodTo    DateTime
  totalAmount Decimal                @db.Decimal(12, 2)
  status      CutoffSettlementStatus @default(OPEN)
  closedAt    DateTime?
  paidAt      DateTime?
  paidById    String?
  note        String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([tenantId, brandId, periodTo])
}

model SaleLine {
  id           String  @id @default(cuid())
  saleId       String
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  commission   Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  inSettlement Boolean @default(false)
  paid         Boolean @default(false)

  @@index([productId])
  @@index([saleId])
}

model SalePayment {
  id     String             @id @default(cuid())
  saleId String
  sale   Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method SplitPaymentMethod
  amount Decimal            @db.Decimal(10, 2)

  @@index([saleId])
}

model Layaway {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  status        LayawayStatus    @default(OPEN)
  subtotal      Decimal          @db.Decimal(10, 2)
  total         Decimal          @db.Decimal(10, 2)
  balance       Decimal          @db.Decimal(10, 2)
  deposit       Decimal          @default(0) @db.Decimal(10, 2)
  ticketComment String?
  applyTax      Boolean          @default(false)
  taxRate       Decimal          @default(0.16) @db.Decimal(5, 4)
  taxAmount     Decimal          @default(0) @db.Decimal(10, 2)
  customerId    String?
  customer      Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         LayawayLine[]
  payments      LayawayPayment[]
  sale          Sale?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

model LayawayLine {
  id        String  @id @default(cuid())
  layawayId String
  layaway   Layaway @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  @@index([layawayId])
  @@index([productId])
}

model LayawayPayment {
  id        String             @id @default(cuid())
  layawayId String
  layaway   Layaway            @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  method    SplitPaymentMethod
  amount    Decimal            @db.Decimal(10, 2)
  createdAt DateTime           @default(now())

  @@index([layawayId])
}

model ProductRequest {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId       String
  brand         Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                 @relation("ProductRequestCreatedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  type          ProductRequestType
  status        ProductRequestStatus @default(PENDING)
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String?
  sku           String?
  categoryId    String?
  category      Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description   String?
  price         Decimal?             @db.Decimal(10, 2)
  imageUrl      String?
  quantity      Int
  minStock      Int                  @default(5)
  notes         String?
  acceptedById  String?
  acceptedBy    User?                @relation("ProductRequestAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  rejectedById  String?
  rejectedBy    User?                @relation("ProductRequestRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([brandId, status])
}

model AgendaSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockDeliveryEnabled Boolean  @default(true)
  cutPickupEnabled     Boolean  @default(true)
  timezone             String   @default("America/Mexico_City")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// One weekly recurrence row per action + weekday (1=Mon … 7=Sun).
model WeeklyScheduleRule {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            ScheduleType
  weekday         Int
  startTime       String
  endTime         String
  intervalMinutes Int
  active          Boolean        @default(true)
  slots           ScheduleSlot[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, type, weekday])
  @@index([tenantId, type])
}

model ScheduleSlot {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        ScheduleType
  startAt     DateTime
  endAt       DateTime
  active      Boolean             @default(true)
  ruleId      String?
  rule        WeeklyScheduleRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  appointment StockAppointment?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, type, startAt, endAt])
  @@index([tenantId, type, startAt])
  @@index([ruleId])
}

/// Agenda de entregas/retiros (antes Appointment). Conserva brandId/slotId/bookedById.
model StockAppointment {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId    String
  brand      Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slotId     String       @unique
  slot       ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  bookedById String
  bookedBy   User         @relation(fields: [bookedById], references: [id], onDelete: Restrict)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([tenantId, createdAt])
  @@index([brandId, createdAt])
}

model WhatsappConfig {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phoneNumberId      String   @default("")
  wabaId             String   @default("")
  accessToken        String   @default("")
  webhookVerifyToken String   @default("")
  systemPrompt       String   @default("") @db.Text
  isActive           Boolean  @default(false)
  /// Datos del número propio, leídos de Meta al conectar.
  displayPhoneNumber String   @default("")
  verifiedName       String   @default("")
  /// Estado de la plantilla de recordatorio en la cuenta del negocio: APPROVED | PENDING | REJECTED | "".
  templateStatus     String   @default("")
  /// El negocio puede apagar sus recordatorios automáticos.
  remindersEnabled   Boolean  @default(true)
  /// El asistente de IA responde los mensajes entrantes de este número (plan Citas + IA).
  aiEnabled          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([phoneNumberId])
}

model Service {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int
  price           Decimal       @db.Decimal(10, 2)
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId])
}

model BusinessHour {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, dayOfWeek])
  @@index([tenantId])
}

model Sucursal {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  isActive      Boolean        @default(true)
  appointments  Appointment[]
  conversations Conversation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model Conversation {
  id                 String                @id @default(cuid())
  tenantId           String
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerPhone      String
  customerName       String?
  aiEnabled          Boolean               @default(true)
  selectedSucursalId String?
  selectedSucursal   Sucursal?             @relation(fields: [selectedSucursalId], references: [id], onDelete: SetNull)
  humanRequestedAt   DateTime?
  humanRequestReason String?
  messages           ConversationMessage[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([tenantId, customerPhone])
  @@index([tenantId])
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           ConversationRole
  content        String           @db.Text
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

/// Citas a clientes (WhatsApp / clínica). Tabla nueva, sin brandId/slotId/bookedById.
model Appointment {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sucursalId        String?
  sucursal          Sucursal?         @relation(fields: [sucursalId], references: [id], onDelete: SetNull)
  serviceId         String?
  service           Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  customerName      String
  customerPhone     String
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(PENDING)
  notes             String?
  /// Recordatorio por WhatsApp: fecha de envío exitoso (null = pendiente).
  reminderSentAt    DateTime?
  /// Intentos fallidos de recordatorio (se detiene tras el máximo).
  reminderAttempts  Int               @default(0)
  /// Id del mensaje de WhatsApp del recordatorio (wamid).
  reminderMessageId String?
  /// Respuesta del cliente con los botones del recordatorio: CONFIRM | CANCEL | RESCHEDULE.
  customerReply     String?
  customerRepliedAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@index([sucursalId])
  @@index([status, reminderSentAt, startTime])
}

/// Versión publicada de los términos. Una versión publicada NO se edita:
/// los cambios se publican como versión nueva (la constancia de aceptación
/// guarda la huella del texto aceptado).
model TermsDocument {
  id          String   @id @default(cuid())
  version     String   @unique
  title       String
  content     String
  /// Resumen de qué cambió respecto a la versión anterior (se muestra al pedir la nueva aceptación).
  summary     String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

/// Evidencia de quién aceptó qué versión de los términos y cuándo.
/// Sobrevive a la eliminación de la cuenta (userId queda en null) durante el
/// plazo de conservación definido en lib/retention.ts.
model TermsAcceptance {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  version       String
  signedName    String
  acceptedAt    DateTime  @default(now())
  ip            String?
  /// Correo de la cuenta al momento de aceptar.
  email         String?
  userAgent     String?
  /// SHA-256 del texto aceptado: prueba qué contenido exacto se aceptó.
  contentHash   String?
  /// "register" | "reaccept"
  source        String    @default("register")
  /// Fecha en que se eliminó la cuenta; a partir de aquí corre el plazo de conservación.
  userDeletedAt DateTime?

  @@unique([userId, version])
  @@index([userId])
  @@index([acceptedAt])
}

/// Bitácora de consentimientos opcionales (hoy: correos de marketing).
model ConsentEvent {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String
  /// "MARKETING_EMAIL"
  kind          String
  granted       Boolean
  /// "register" | "account" | "unsubscribe_link"
  source        String
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  userDeletedAt DateTime?

  @@index([userId])
  @@index([kind, createdAt])
}

/// Configuración de plataforma editable por el SUPER_ADMIN (p. ej. rastreadores).
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Reclamos de derechos de autor recibidos por el canal público.
model CopyrightClaim {
  id              String    @id @default(cuid())
  claimantName    String
  claimantEmail   String
  claimantPhone   String?
  /// A nombre de quién actúa (titular o representante).
  rightsHolder    String
  workDescription String    @db.Text
  infringingUrl   String    @db.Text
  details         String?   @db.Text
  signature       String
  /// "OPEN" | "IN_REVIEW" | "RESOLVED" | "REJECTED"
  status          String    @default("OPEN")
  adminNote       String?   @db.Text
  ip              String?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
}

/// Bitácora de acciones del SUPER_ADMIN en el panel de plataforma.
model AdminAuditLog {
  id          String   @id @default(cuid())
  /// Sin relación: la entrada sobrevive aunque se elimine la cuenta del administrador.
  actorId     String?
  actorEmail  String
  /// p. ej. "tenant.suspend", "promo.create", "terms.publish"
  action      String
  targetType  String?
  targetId    String?
  targetLabel String?
  details     Json?
  ip          String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/// Registro de cuentas eliminadas (a petición del titular, por el SUPER_ADMIN o por retención).
model AccountDeletionLog {
  id         String   @id @default(cuid())
  email      String?
  tenantName String?
  /// "TENANT" | "USER"
  scope      String
  /// "user_request" | "super_admin" | "retention_inactive" | "retention_unverified"
  reason     String
  ip         String?
  deletedAt  DateTime @default(now())

  @@index([deletedAt])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model SmsVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PromoCode {
  id                String     @id @default(cuid())
  code              String     @unique
  /// Días de prueba gratis que da el código (sin código no hay prueba; 0 = solo descuento).
  trialDays         Int        @default(0)
  /// Descuento en porcentaje sobre la mensualidad (1-100). Excluyente con discountAmountMxn.
  discountPercent   Int?
  /// Descuento fijo en pesos (IVA incluido) sobre la mensualidad.
  discountAmountMxn Int?
  /// Cuántas mensualidades pagadas cubre el descuento.
  discountMonths    Int?
  /// Planes donde aplica el código (vacío = todos).
  planTypes         PlanType[] @default([])
  active            Boolean    @default(true)
  maxUses           Int?
  usedCount         Int        @default(0)
  /// Fecha límite para canjearlo (null = sin vencimiento).
  expiresAt         DateTime?
  /// Nota interna (campaña, a quién se le dio).
  note              String?
  createdAt         DateTime   @default(now())
}

model TenantSubscription {
  id                     String             @id @default(cuid())
  tenantId               String             @unique
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planType               PlanType
  status                 SubscriptionStatus @default(TRIALING)
  trialEndsAt            DateTime
  promoCodeUsed          String?
  /// Stub de pago futuro (Stripe / Mercado Pago). true = eligió prueba sin cobrar aún.
  paymentDeferred        Boolean            @default(false)
  currentPeriodEndsAt    DateTime?
  /// "stripe" | "mercadopago" | null hasta integrar cobro.
  paymentProvider        String?
  externalCustomerId     String?
  /// ID de la suscripción en el proveedor (Stripe: sub_...).
  externalSubscriptionId String?
  /// ID del precio contratado en el proveedor (Stripe: price_...).
  priceId                String?
  /// true si el cliente canceló y la cuenta sigue activa hasta currentPeriodEndsAt.
  cancelAtPeriodEnd      Boolean            @default(false)
  lastPaymentAt          DateTime?
  /// Fecha de cobro para la que ya se envió el aviso de renovación automática.
  renewalNoticeFor       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([externalCustomerId])
  @@index([externalSubscriptionId])
}

enum ReferralStatus {
  /// El negocio recomendado se registró con el código; aún no paga.
  PENDING
  /// El recomendado pagó su primer mes; el premio espera a que quien recomendó tenga cliente en Stripe.
  QUALIFIED
  /// Crédito de un mes aplicado al saldo de Stripe de quien recomendó.
  REWARDED
  /// Superó el tope de premios o se anuló.
  VOID
}

/// Programa de referidos: un negocio recomienda a otro con su código.
model Referral {
  id                 String         @id @default(cuid())
  referrerTenantId   String
  referrer           Tenant         @relation("ReferralReferrer", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referredTenantId   String         @unique
  referred           Tenant         @relation("ReferralReferred", fields: [referredTenantId], references: [id], onDelete: Cascade)
  status             ReferralStatus @default(PENDING)
  /// Crédito otorgado en centavos MXN.
  rewardAmountCents  Int?
  stripeBalanceTxnId String?
  qualifiedAt        DateTime?
  rewardedAt         DateTime?
  createdAt          DateTime       @default(now())

  @@index([referrerTenantId])
}

/// Idempotencia de webhooks de cobro: un evento del proveedor se procesa una sola vez.
model ProcessedWebhookEvent {
  id        String   @id
  provider  String
  type      String
  createdAt DateTime @default(now())
}

model BusinessPreferences {
  id                          String       @id @default(cuid())
  tenantId                    String       @unique
  tenant                      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryTerminalCommission   Decimal?     @db.Decimal(5, 2)
  secondaryTerminalCommission Decimal?     @db.Decimal(5, 2)
  transferCommission          Decimal?     @db.Decimal(5, 2)
  layawayDueDays              Int          @default(15)
  labelWidthMm                Int?
  labelHeightMm               Int?
  flexibleInventory           Boolean      @default(false)
  printTickets                Boolean      @default(true)
  ticketFixedComment          String?
  chargeIva                   Boolean      @default(false)
  /// Los precios de lista ya traen el IVA: al cobrar se desglosa en vez de sumarse.
  pricesIncludeIva            Boolean      @default(false)
  usdEnabled                  Boolean      @default(false)
  usdRateMode                 UsdRateMode?
  usdFixedRate                Decimal?     @db.Decimal(10, 4)
  cutoffType                  CutoffType   @default(MONTHLY_FIXED)
  cutoffWeekday               Int?
  cutoffDaySlots              Int[]
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
}

model Category {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  slug            String
  active          Boolean          @default(true)
  products        Product[]
  productRequests ProductRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

/// Venta cancelada: la venta se elimina de `Sale` (así ningún reporte la suma)
/// y aquí queda la copia completa para consulta y auditoría.
model CancelledSale {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNumber    Int
  soldAt          DateTime
  total           Decimal  @db.Decimal(10, 2)
  customerId      String?
  customerName    String?
  reason          String?
  /// Copia de la venta (líneas, pagos, quién atendió) al momento de cancelar.
  snapshot        Json
  cancelledById   String?
  cancelledByName String?
  cancelledAt     DateTime @default(now())

  @@index([tenantId, cancelledAt])
  @@index([tenantId, customerId])
}

/// Turno de caja: fondo inicial al abrir y arqueo al cerrar.
model CashSession {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status       CashSessionStatus @default(OPEN)
  openedAt     DateTime          @default(now())
  openedById   String?
  openedByName String?
  openingFloat Decimal           @default(0) @db.Decimal(10, 2)
  closedAt     DateTime?
  closedById   String?
  closedByName String?
  /// Efectivo que debería haber en caja al cerrar.
  expectedCash Decimal?          @db.Decimal(10, 2)
  /// Efectivo contado al cerrar.
  countedCash  Decimal?          @db.Decimal(10, 2)
  difference   Decimal?          @db.Decimal(10, 2)
  /// Resumen del turno al cerrar (ventas por método, abonos, movimientos).
  summary      Json?
  note         String?
  movements    CashMovement[]

  @@index([tenantId, status])
  @@index([tenantId, openedAt])
}

/// Entrada o retiro de efectivo durante un turno (no es una venta).
model CashMovement {
  id            String           @id @default(cuid())
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amount        Decimal          @db.Decimal(10, 2)
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime         @default(now())

  @@index([cashSessionId])
}
