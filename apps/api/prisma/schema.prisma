generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  BRAND
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

enum ProductRequestType {
  CREATE_PRODUCT
  RESTOCK
}

enum ProductRequestStatus {
  PENDING
  ACCEPTED
}

enum ScheduleType {
  STOCK_DELIVERY
  CUT_PICKUP
}

model Tenant {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  active          Boolean           @default(true)
  users           User[]
  brands          Brand[]
  sales           Sale[]
  productRequests ProductRequest[]
  agendaSettings  AgendaSettings?
  weeklyRules     WeeklyScheduleRule[]
  scheduleSlots   ScheduleSlot[]
  appointments    Appointment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  password           String
  name               String
  role               Role
  mustChangePassword Boolean      @default(false)
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId            String?
  brand              Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  stockEntries       StockEntry[]
  sales              Sale[]
  requestedProducts  ProductRequest[] @relation("ProductRequestCreatedBy")
  acceptedProducts   ProductRequest[] @relation("ProductRequestAcceptedBy")
  appointments       Appointment[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([tenantId])
}

model Brand {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  contactEmail String?
  whatsapp    String?
  active       Boolean   @default(true)
  isHouseBrand Boolean   @default(false)
  products     Product[]
  users        User[]
  productRequests ProductRequest[]
  appointments Appointment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id           String       @id @default(cuid())
  brandId      String
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name         String
  sku          String
  description  String?
  price        Decimal?     @db.Decimal(10, 2)
  imageUrl     String?
  stock        Stock?
  stockEntries StockEntry[]
  saleLines    SaleLine[]
  productRequests ProductRequest[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([brandId, sku])
}

model Stock {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(0)
  minStock  Int     @default(5)
  updatedAt DateTime @updatedAt
}

model StockEntry {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([productId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNumber  Int           @unique @default(autoincrement())
  paymentMethod PaymentMethod
  soldAt        DateTime      @default(now())
  createdById   String?
  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines         SaleLine[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId, soldAt])
}

model SaleLine {
  id           String  @id @default(cuid())
  saleId       String
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  commission   Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  inSettlement Boolean @default(false)
  paid         Boolean @default(false)

  @@index([productId])
  @@index([saleId])
}

model ProductRequest {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId       String
  brand         Brand                @relation(fields: [brandId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User                 @relation("ProductRequestCreatedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  type          ProductRequestType
  status        ProductRequestStatus @default(PENDING)
  productId     String?
  product       Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String?
  sku           String?
  description   String?
  price         Decimal?             @db.Decimal(10, 2)
  imageUrl      String?
  quantity      Int
  minStock      Int                  @default(5)
  notes         String?
  acceptedById  String?
  acceptedBy    User?                @relation("ProductRequestAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt    DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([brandId, status])
}

model AgendaSettings {
  id                   String   @id @default(cuid())
  tenantId             String   @unique
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockDeliveryEnabled Boolean  @default(true)
  cutPickupEnabled     Boolean  @default(true)
  timezone             String   @default("America/Mexico_City")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

/// One weekly recurrence row per action + weekday (1=Mon … 7=Sun).
model WeeklyScheduleRule {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            ScheduleType
  weekday         Int
  startTime       String
  endTime         String
  intervalMinutes Int
  active          Boolean      @default(true)
  slots           ScheduleSlot[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([tenantId, type, weekday])
  @@index([tenantId, type])
}

model ScheduleSlot {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        ScheduleType
  startAt     DateTime
  endAt       DateTime
  active      Boolean             @default(true)
  ruleId      String?
  rule        WeeklyScheduleRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  appointment Appointment?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([tenantId, type, startAt, endAt])
  @@index([tenantId, type, startAt])
  @@index([ruleId])
}

model Appointment {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandId    String
  brand      Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  slotId     String       @unique
  slot       ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  bookedById String
  bookedBy   User         @relation(fields: [bookedById], references: [id], onDelete: Restrict)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([tenantId, createdAt])
  @@index([brandId, createdAt])
}
