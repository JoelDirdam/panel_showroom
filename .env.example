# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cosdi
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
SEED_PASSWORD=Showroom2026!
PORT=3000
# Token global de verificación del webhook de Meta (opcional; si falta, se usa WhatsappConfig.webhookVerifyToken)
WHATSAPP_VERIFY_TOKEN=

# Correo transaccional (Resend). Sin esto, en producción NO se envían códigos de verificación.
RESEND_API_KEY=
EMAIL_FROM=COSDI <no-reply@cosdi.mx>

# Cobro de suscripciones (Stripe). En dev y staging usa claves de PRUEBA (sk_test_ / whsec_ de test).
# Producción: claves live, guardadas solo en las variables de Railway.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL pública del frontend (retorno de Checkout y del portal). Si falta, se usa el primer CORS_ORIGIN.
APP_URL=http://localhost:5173
# Tasa de IVA (txr_..., inclusiva: el precio ya trae IVA). Vacío = sin impuesto.
STRIPE_TAX_RATE_ID=
# Configuración del portal del cliente (bpc_...). Vacío = la predeterminada de la cuenta.
STRIPE_PORTAL_CONFIG_ID=
# Todo este bloque lo llena solo: node scripts/stripe-setup.mjs <entorno> <url-api> <url-app>
# IDs de precio (price_...) de cada plan, creados en Stripe
STRIPE_PRICE_CITAS_RECORDATORIOS=
STRIPE_PRICE_CITAS_PANEL=
STRIPE_PRICE_CITAS_IA=

# Motor de conversación IA (WhatsApp)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Opcional: proveedor compatible con OpenAI (DeepSeek: https://api.deepseek.com,
# Groq: https://api.groq.com/openai/v1, Gemini: https://generativelanguage.googleapis.com/v1beta/openai/).
# El modelo debe soportar llamadas a herramientas (tools).
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=20000

# Web (Vite build-time)
VITE_API_URL=http://localhost:3000/api
# WhatsApp de soporte para reactivar cuentas pausadas (solo dígitos, ej. 521XXXXXXXXXX)
VITE_SUPPORT_WHATSAPP=
