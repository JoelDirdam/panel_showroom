# API
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cosdi
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
SEED_PASSWORD=Showroom2026!
PORT=3000
# Token global de verificación del webhook de Meta (opcional; si falta, se usa WhatsappConfig.webhookVerifyToken)
WHATSAPP_VERIFY_TOKEN=

# Correo transaccional (Resend). Sin esto, en producción NO se envían códigos de verificación.
RESEND_API_KEY=
EMAIL_FROM=COSDI <no-reply@cosdi.mx>

# Motor de conversación IA (WhatsApp)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000

# Web (Vite build-time)
VITE_API_URL=http://localhost:3000/api
# WhatsApp de soporte para reactivar cuentas pausadas (solo dígitos, ej. 521XXXXXXXXXX)
VITE_SUPPORT_WHATSAPP=
